@startuml Diagrama de Clases - DAO y Servicio

skinparam classAttributeIconSize 0
skinparam class {
    BackgroundColor White
    BorderColor #555
    ArrowColor #333
}
skinparam package {
    BackgroundColor #FAFAFA
}

' ── Capa DAO ──────────────────────────────────────────────────────
package "com.carbonaudit.dao" {

    interface "DAO<T, K>" as DAO {
        + create(entity: T) : T
        + findById(id: K) : Optional<T>
        + findAll() : List<T>
        + update(entity: T) : void
        + delete(id: K) : void
    }

    class DatabaseManager <<Singleton>> {
        - instance : DatabaseManager
        + getInstance() : DatabaseManager
        + getConnection() : Connection
    }

    class EmpresaDAO
    class DireccionDAO
    class FactorEmisionDAO
    class ResponsableDAO
    class EmpleadoDAO
    class DepartamentoDAO {
        + findAllByEmpresa(idEmpresa) : List
    }
    class ConsumoMensualDAO {
        + getConsumosDepartamentoMes(idDept, mes, anio) : List
    }
    class CommutingEmpleadoDAO {
        + getCommutingsDepartamentoMes(idDept, mes, anio) : List
    }
}

' Implementaciones de la interfaz genérica
EmpresaDAO          ..|> DAO
DepartamentoDAO     ..|> DAO
EmpleadoDAO         ..|> DAO
ConsumoMensualDAO   ..|> DAO
CommutingEmpleadoDAO ..|> DAO
FactorEmisionDAO    ..|> DAO
DireccionDAO        ..|> DAO
ResponsableDAO      ..|> DAO

' Todos los DAOs usan DatabaseManager
DAO ..> DatabaseManager : usa

' ── Capa Servicio ─────────────────────────────────────────────────
package "com.carbonaudit.service" {

    interface IServicioGeografico {
        + completarCoordenadas(dir: Direccion) : void
        + calcularDistancia(origen: Direccion, destino: Direccion) : BigDecimal
    }

    class ServicioGeograficoORS implements IServicioGeografico

    class ServicioCalculoHuella {
        + getCommutingMensual(emp: Empleado) : BigDecimal
        + getConsumosMensuales(idDept, mes, anio) : List
        + getConsumosMensualesEmpresa(idEmpresa, mes, anio) : List
        + getConsumosAnualesEmpresa(idEmpresa, anio) : List
        + getTotalConsumos(consumos: List) : BigDecimal
        + crearConsumo(consumo: ConsumoMensual) : void
        + actualizarConsumo(consumo: ConsumoMensual) : void
        + eliminarConsumo(idConsumo: int) : void
        + getHuellaTotalDepartamentoMes(dept, mes, anio) : BigDecimal
        + getHuellaTotalEmpresaMes(empresa, mes, anio) : BigDecimal
        + getHuellaPorScope(dept, mes, anio) : Map
        + getHuellaAnualDepartamento(dept, anio) : BigDecimal
        + getHuellaAnualEmpresa(empresa, anio) : BigDecimal
        + getVariacionMensual(dept, mes, anio) : BigDecimal
    }

    class ServicioGestionEmpleado {
        + crearEmpleado(empleado: Empleado) : Empleado
        + actualizarEmpleado(empleado: Empleado) : void
        + darDeBajaEmpleado(idEmpleado: int, fecha: LocalDate) : void
        + getEmpleadosDepartamento(idDept: int) : List
        + countEmpleadosDepartamento(idDept: int) : int
        + persistirCoordenadas(dir: Direccion) : void
        + calcularYPersistirDistancia(empleado: Empleado) : void
    }

    class ServicioGestionEmpresa {
        + getEmpresas() : List
        + crearEmpresa(empresa: Empresa) : void
        + actualizarEmpresa(empresa: Empresa) : void
        + eliminarEmpresa(idEmpresa: int) : void
        + persistirCoordenadas(dir: Direccion) : void
    }

    class ServicioGestionDepartamento {
        + getDepartamentosEmpresa(idEmpresa: int) : List
        + crearDepartamento(departamento: Departamento) : void
        + actualizarDepartamento(departamento: Departamento) : void
        + eliminarDepartamento(idDepartamento: int) : void
    }

    class ServicioGestionResponsable {
        + getAllActivos() : List
        + getActivoByDepartamento(idDept: int) : Optional
        + getAllByDepartamento(idDept: int) : List
        + crearResponsable(responsable: Responsable) : void
        + actualizarResponsable(responsable: Responsable) : void
    }

    class ServicioGestionFactores {
        + getFactores() : List
        + getFactoresPorAlcance(alcance: int) : List
        + crearFactor(factor: FactorEmision) : void
        + actualizarFactor(factor: FactorEmision) : void
        + eliminarFactor(idFactor: int) : void
    }
}

' Dependencias de ServicioCalculoHuella
ServicioCalculoHuella ..> ConsumoMensualDAO    : usa
ServicioCalculoHuella ..> CommutingEmpleadoDAO : usa
ServicioCalculoHuella ..> DepartamentoDAO      : usa

' Dependencias de ServicioGestionEmpleado
ServicioGestionEmpleado --> IServicioGeografico
ServicioGestionEmpleado ..> EmpleadoDAO   : usa
ServicioGestionEmpleado ..> DireccionDAO  : usa

' Dependencias de ServicioGestionEmpresa
ServicioGestionEmpresa ..> EmpresaDAO    : usa
ServicioGestionEmpresa ..> DireccionDAO  : usa

' Dependencias de ServicioGestionDepartamento
ServicioGestionDepartamento ..> DepartamentoDAO : usa

' Dependencias de ServicioGestionResponsable
ServicioGestionResponsable ..> ResponsableDAO : usa

' Dependencias de ServicioGestionFactores
ServicioGestionFactores ..> FactorEmisionDAO : usa


@enduml
