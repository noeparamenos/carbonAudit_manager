@startuml Diagrama de Secuencia - Consultar Huella de Carbono

skinparam sequenceArrowThickness 1.5
skinparam participant {
    BackgroundColor White
    BorderColor #555
}
skinparam actor {
    BorderColor #555
}
skinparam sequence {
    LifeLineBorderColor #777
    GroupBackgroundColor #F5F5F5
    GroupBorderColor #AAAAAA
}

actor "Responsable" as Resp
participant "Vista\n(JavaFX)" as UI
participant "PR1Controller" as Ctrl
participant "ServicioCalculoHuella" as Servicio
participant "ConsumoMensualDAO" as ConsumoDAO
participant "CommutingEmpleadoDAO" as CommutingDAO
database "Base de Datos" as BD

' ========================= FLUJO PRINCIPAL =========================

Resp -> UI : 1. navega al tab "Huella mensual"\n(o cambia el período estando en él)
activate UI

UI -> Ctrl : 1.1. cargarHuella()
activate Ctrl

' --- Paso 1: refresca listaConsumos a través del Servicio ---
Ctrl -> Servicio : 1.1.1. getConsumosMensuales(idDept, mes, anio)\n[refresca listaConsumos compartida]
activate Servicio
    Servicio -> ConsumoDAO : 1.1.1.1. getConsumosDepartamentoMes(idDept, mes, anio)
    activate ConsumoDAO
        ConsumoDAO -> BD : 1.1.1.1.1. SELECT consumos WHERE idDept, mes, anio
        BD --> ConsumoDAO : 1.1.1.1.2. List<ConsumoMensual>
    ConsumoDAO --> Servicio : 1.1.1.2. List<ConsumoMensual>
    deactivate ConsumoDAO
Servicio --> Ctrl : 1.1.2. List<ConsumoMensual>
deactivate Servicio

' --- Paso 2: getHuellaTotalDepartamentoMes ---
Ctrl -> Servicio : 1.1.3. getHuellaTotalDepartamentoMes(departamento, mes, anio)
activate Servicio

Servicio -> ConsumoDAO : 1.1.3.1. getConsumosDepartamentoMes(idDept, mes, anio)
activate ConsumoDAO
    ConsumoDAO -> BD : 1.1.3.1.1. SELECT consumos WHERE idDept, mes, anio
    BD --> ConsumoDAO : 1.1.3.1.2. List<ConsumoMensual>
ConsumoDAO --> Servicio : 1.1.3.2. List<ConsumoMensual>
deactivate ConsumoDAO

loop por cada ConsumoMensual
    Servicio -> Servicio : 1.1.3.3. calcularEmision()
    note right : cantidad × valorFactor
end

opt departamento.incluirAlcance3 == true
    Servicio -> CommutingDAO : 1.1.3.4. getCommutingsDepartamentoMes(idDept, mes, anio)
    activate CommutingDAO
        CommutingDAO -> BD : 1.1.3.4.1. SELECT commutings WHERE idDept, mes, anio
        BD --> CommutingDAO : 1.1.3.4.2. List<CommutingEmpleado>
    CommutingDAO --> Servicio : 1.1.3.5. List<CommutingEmpleado>
    deactivate CommutingDAO

    loop por cada CommutingEmpleado
        Servicio -> Servicio : 1.1.3.6. calcularEmisionCommuting(commuting)
        note right : km × 2 × días × valorFactor
    end
end

Servicio --> Ctrl : 1.1.4. totalEmisiones (BigDecimal, kgCO2e)
deactivate Servicio

' --- Paso 3: getHuellaPorScope ---
Ctrl -> Servicio : 1.1.5. getHuellaPorScope(departamento, mes, anio)
activate Servicio

Servicio -> ConsumoDAO : 1.1.5.1. getConsumosDepartamentoMes(idDept, mes, anio)
activate ConsumoDAO
    ConsumoDAO -> BD : 1.1.5.1.1. SELECT consumos WHERE idDept, mes, anio
    BD --> ConsumoDAO : 1.1.5.1.2. List<ConsumoMensual>
ConsumoDAO --> Servicio : 1.1.5.2. List<ConsumoMensual>
deactivate ConsumoDAO

loop por cada ConsumoMensual
    Servicio -> Servicio : 1.1.5.3. agrupar emisión por scope
    note right : resultado.merge(scope, calcularEmision())
end

opt departamento.incluirAlcance3 == true
    Servicio -> CommutingDAO : 1.1.5.4. getCommutingsDepartamentoMes(idDept, mes, anio)
    activate CommutingDAO
        CommutingDAO -> BD : 1.1.5.4.1. SELECT commutings WHERE idDept, mes, anio
        BD --> CommutingDAO : 1.1.5.4.2. List<CommutingEmpleado>
    CommutingDAO --> Servicio : 1.1.5.5. List<CommutingEmpleado>
    deactivate CommutingDAO

    loop por cada CommutingEmpleado
        Servicio -> Servicio : 1.1.5.6. calcularEmisionCommuting(commuting)
        note right : km × 2 × días × valorFactor
    end
end

Servicio --> Ctrl : 1.1.6. Map<Integer, BigDecimal> (Scope 1, 2, 3)
deactivate Servicio

Ctrl --> UI : 1.1.7. actualiza KPIs y lblCommuting
deactivate Ctrl

UI --> Resp : 1.2. muestra resultado en pantalla
deactivate UI

@enduml